{
  "name": "whiteboat",
  "version": "0.1.3",
  "private": true,
  "description": "Begin on a quiet water surface and turn a thought into a new Canvas.",
  "main": "main.js",
  "scripts": {
    "build": "tsc -noEmit --skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "vitest run --config vitest.water.config.mjs",
    "test:unit": "vitest run --config vitest.water.config.mjs",
    "check:release": "node scripts/check-water-release.mjs",
    "check:community-source:clean": "node scripts/check-community-source.mjs clean",
    "check:community-source:built": "node scripts/check-community-source.mjs built",
    "test:community-source": "node --test test/unit/community-source-check.test.mjs",
    "check:community": "node scripts/check-community-source.mjs all",
    "core:build": "node scripts/build-core.mjs",
    "prebuild": "npm run core:build && node scripts/sync-core-water-css.mjs",
    "lint:community": "eslint src vendor/whiteboat-core/src && npm run check:community-css",
    "check:community-css": "node scripts/check-community-css.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "whiteboat"
  ],
  "author": "千百慧",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@eslint/json": "0.14.0",
    "@types/howler": "^2.2.13",
    "@types/node": "^20.19.0",
    "@types/three": "^0.180.0",
    "esbuild": "^0.28.2",
    "eslint": "9.39.1",
    "eslint-plugin-obsidianmd": "0.4.2",
    "obsidian": "1.8.7",
    "postcss": "8.5.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vitest": "^3.2.7",
    "whiteboat-core": "file:vendor/whiteboat-core"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "three": "^0.180.0"
  }
}
